# Nix build outputs
result
result-*

# scaffold state (profiles, logs, caches)
.scaffold/

# generated by logos-module-builder at build time
generated_code/

# editor / OS
*.swp
.DS_Store
.scaffold

# AI tool directories. Generated or machine-local: `lgs init`'s output,
# `openspec init`'s skills and commands, settings.local.json, worktrees.
#
# The role agents are the exception: they are part of the process rather than
# one machine's settings, so they belong in the repo.
#
# `.claude/*` rather than `.claude/` because git will not re-include a file
# whose parent DIRECTORY is excluded — with a `.claude/` rule the negation
# below is never consulted and `.claude/agents/` stays invisible.
#
# A directory negation is RECURSIVE, which is why it is narrowed again below.
# `!.claude/agents/` alone stops `.claude/*` applying to anything beneath it,
# so a nested scratch directory, a stray `settings.local.json`, or any build
# leftover dropped in there becomes trackable — in the one namespace the
# comment above admits is "generated or machine-local". The failure is a
# generated file committed silently, which nobody notices, rather than a
# tracked file going missing, which somebody does.
#
# So: re-exclude everything under `agents/`, then re-admit only the role files
# themselves. Verified with `git check-ignore`: `agents/code-reviewer.md` is
# tracked, `agents/scratch/tmp.json` and `agents/settings.local.json` are not.
.claude/*
!.claude/agents/
.claude/agents/*
!.claude/agents/*.md
.cursor/
AGENTS.md

# agent scratch space
tmp/

# test run output
radicle-ui/tests/out.txt
radicle-ui/tests/results.txt

# release staging (ci.yml) — ui-tests.yml no longer stages here, it reads
# .scaffold/basecamp/lgx/ directly
dist/

# UI test run outputs (ui-tests.yml)
basecamp/
ui-results/

# local scratch: the inspector-enabled Basecamp copy, staged .lgx files,
# throwaway user-dirs and build logs from running the end-to-end layer by hand
tmp/
