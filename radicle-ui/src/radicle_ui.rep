// View contract for the Radicle UI.
//
// This is deliberately thin. Every slot is a pass-through to the `radicle`
// core module, which owns all the business logic: HTTP to seed nodes, JSON
// parsing, SHA resolution and local-profile detection. Nothing here parses
// Radicle data or talks to the network itself.
//
// The remote*/local* split from the core module's API is preserved verbatim
// rather than collapsed into one "fetch" call: which source you are asking is
// a user-visible fact (different reachability, different privacy, read-only vs
// writable), so the view stays explicit about it.
//
// Every slot returns a JSON string — the shapes are the core module's
// contract. Failures are always {"error":"..."}. QML receives these via
// logos.watch(...) and renders them; it never constructs a request URL.
class RadicleUi
{
    // --- source-neutral ---------------------------------------------------
    SLOT(QString getCapabilities())
    SLOT(QString listKnownSeeds())
    SLOT(QString setRemoteSeed(QString seedUrl))
    // Module settings: which node mode is active, where its home and socket
    // are, and where git lives. Source-neutral because they describe the
    // module rather than either data source. setSetting validates on write and
    // returns the whole settings object, so a view re-renders from one reply.
    SLOT(QString getSettings())
    SLOT(QString setSetting(QString key, QString value))

    // The embedded node's identity: what Basecamp's own Radicle home holds,
    // and creating one in it. Source-neutral for the same reason settings are —
    // they describe the module's own home, not either data source.
    //
    // Neither takes a home, deliberately: a home argument crossing this
    // boundary would be a way for a VIEW to point key creation at the user's
    // real ~/.radicle, and a sandboxed QML view is the last place that decision
    // belongs. The path is the core module's to derive.
    //
    // Plumbed through now, ahead of the wizard that calls them, so that the
    // wizard is a QML-only change. The alternative — adding the slot alongside
    // the screen — would put a transport change and a UI change in one diff,
    // and this pair is the boundary most worth reviewing on its own.
    SLOT(QString getEmbeddedIdentity())
    SLOT(QString createEmbeddedIdentity(QString alias, QString passphrase))

    // The node itself: start it, stop it, ask what it is doing. The daemon half
    // of Embedded, and the only slots here that leave something RUNNING after
    // they return — everything else answers and is finished.
    //
    // Neither start nor status takes a home or a socket, for the same reason
    // the identity pair above takes no home: those paths are the core module's
    // to resolve. One handed across this boundary would let a sandboxed view
    // point a node at the user's own ~/.radicle, and would let the node bind a
    // socket the read path is not watching — at which point localNodeRunning
    // reports false forever about a node running perfectly.
    //
    // startNode's passphrase is not optional for an encrypted identity: the
    // node is given a decrypted signing key when it is built, so there is no
    // later point to supply one. Pass "" for an identity created without a
    // passphrase, which is what createEmbeddedIdentity(alias, "") makes.
    //
    // getNodeStatus reports `running` AND `serving` and a view needs both:
    // `running` is bookkeeping, `serving` probes the control socket, and the
    // states where they disagree — starting up, or failed internally — are the
    // ones a user cannot otherwise account for. See radicle_impl.h.
    SLOT(QString startNode(QString passphrase))
    SLOT(QString stopNode())
    SLOT(QString getNodeStatus())

    // The node's own configuration, and its seeding policies. Two stores, and a
    // view has to tell the user which one it just wrote: a config change reaches
    // the node at its NEXT START (it reads config.json when it is constructed,
    // so there is no later point), while a seeding change applies at once.
    // getNodeConfig's `restartRequired` is what says a change is pending, and it
    // is a comparison against what the running node started with rather than a
    // flag — so undoing a change clears it.
    //
    // None of them takes a home, for the reason the node slots above take none,
    // and it matters more here because three of them WRITE: a home crossing this
    // boundary from a sandboxed view would let it rewrite the configuration and
    // seeding policies of a node the module does not own.
    //
    // setNodeConfig takes a JSON object naming a SUBSET of alias, listen,
    // externalAddresses, connect and peers, and returns the WHOLE configuration
    // — so a panel re-renders from what was stored rather than from what it
    // submitted. A refusal names the value and the spelling expected; show it
    // verbatim, because the two address fields are not interchangeable (connect
    // carries a node id, externalAddresses does not) and a paraphrase loses the
    // one thing that says which.
    //
    // seedRepo's scope is `all` or `followed` and is never defaulted here: `all`
    // is what a PRIVATE repository needs, and a view offering this must state
    // that a delegate allow-listing this node's DID is not sufficient on its own
    // — this node must also seed the repository. That pair is the footgun the
    // surface exists to remove.
    SLOT(QString getNodeConfig())
    SLOT(QString setNodeConfig(QString changes))
    SLOT(QString listSeeded())
    SLOT(QString seedRepo(QString rid, QString scope))
    SLOT(QString unseedRepo(QString rid))

    // --- remote: proxied to a public seed, no local node needed ------------
    SLOT(QString remoteListRepos(QString query, int page, int perPage))
    SLOT(QString remoteGetRepo(QString rid))
    SLOT(QString remoteListBranches(QString rid))
    SLOT(QString remoteGetTree(QString rid, QString sha, QString path))
    SLOT(QString remoteGetBlob(QString rid, QString sha, QString path))
    SLOT(QString remoteGetReadme(QString rid, QString sha))
    SLOT(QString remoteListCommits(QString rid, QString sha, int page, int perPage))
    SLOT(QString remoteGetCommit(QString rid, QString sha))
    SLOT(QString remoteListIssues(QString rid, QString status, int page, int perPage))
    SLOT(QString remoteGetIssue(QString rid, QString id))
    SLOT(QString remoteListPatches(QString rid, QString status, int page, int perPage))
    SLOT(QString remoteGetPatch(QString rid, QString id))

    // --- local: this machine's node, offline-capable, sees private repos ---
    SLOT(QString localListRepos(QString scope, int page, int perPage))
    SLOT(QString localGetRepo(QString rid))
    SLOT(QString localListBranches(QString rid))
    SLOT(QString localGetTree(QString rid, QString sha, QString path))
    SLOT(QString localGetBlob(QString rid, QString sha, QString path))
    SLOT(QString localGetReadme(QString rid, QString sha))
    SLOT(QString localListCommits(QString rid, QString sha, int page, int perPage))
    SLOT(QString localGetCommit(QString rid, QString sha))
    SLOT(QString localListIssues(QString rid, QString status, int page, int perPage))
    SLOT(QString localGetIssue(QString rid, QString id))
    SLOT(QString localListPatches(QString rid, QString status, int page, int perPage))
    SLOT(QString localGetPatch(QString rid, QString id))

    // --- local writes: the only slots here that change state ---------------
    // Local-only by necessity, not symmetry: the seed API rejects writes with
    // HTTP 405, so a remote* counterpart could only ever fail. Gate any UI
    // affordance for these on capabilities.canWriteLocal — see radicle_impl.h.
    SLOT(QString localCommentOnIssue(QString rid, QString id, QString body))
    SLOT(QString localCreateIssue(QString rid, QString title, QString description))

    // Auto-synced summary of what the module can currently do, so the view can
    // show/hide the local source without an explicit round-trip on startup.
    PROP(QString capabilities="" READONLY)
}
